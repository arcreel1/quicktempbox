# Netlify Function configuration for temp mail proxy
# Add these in Netlify Dashboard -> Site configuration -> Environment variables

# Optional: upstream temp mail API base URL
MAILTM_BASE_URL=https://api.mail.tm

# Optional: HttpOnly cookie name for proxy session
TM_SESSION_COOKIE_NAME=tm_session

# Optional: Session cookie lifetime in seconds
TM_SESSION_MAX_AGE=3600
